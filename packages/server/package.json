{
  "name": "@coffre/server",
  "version": "0.1.14",
  "description": "coffre's API, sign-in and scheduled audit job, on Cloudflare Workers or Node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwinkn/coffre.git",
    "directory": "packages/server"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "bin": {
    "coffre-server": "./bin/coffre-server.js"
  },
  "exports": {
    ".": {
      "coffre:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "coffre:source": "./src/cloudflare.ts",
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./node": {
      "coffre:source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=coffre:source --test"
  },
  "dependencies": {
    "@coffre/client": "workspace:*",
    "@coffre/core": "workspace:*",
    "@coffre/db": "workspace:*",
    "@coffre/ui": "workspace:*",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@coffre/vault": "workspace:*",
    "@hegeldev/hegel": "0.4.7",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "pg": "8.16.3",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "wrangler": "4.118.0"
  }
}
