{
  "name": "@coffre/server",
  "version": "0.1.0",
  "description": "coffre's API, sign-in, syncs and scheduled job, on Cloudflare Workers or Node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwinkn/coffre.git",
    "directory": "packages/server"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "bin": {
    "coffre-server": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && rm -rf migrations && cp -r ../db/migrations migrations",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@coffre/ui": "workspace:*",
    "@libsql/client": "0.18.0",
    "@noble/hashes": "2.4.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.3",
    "mysql2": "3.24.4",
    "oauth4webapi": "3.8.8",
    "pg": "8.16.3",
    "tweetnacl": "1.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "tsdown": "0.23.0",
    "typescript": "5.9.3"
  }
}
