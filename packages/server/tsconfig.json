{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // For the tests of the repo's own scripts, which are plain JavaScript.
    "allowJs": true
  },
  // The vault's declaration of `cloudflare:workers`, for test/workers/coffre-worker.ts, which runs the vault's Worker beside coffre's.
  "include": ["src/**/*.ts", "test/**/*.ts", "../vault/src/cloudflare-workers.d.ts"],
  // 0.14's files that do not build on 0.16 yet (docs/design/0.16.md, "Build order"), kept as the source of what is
  // still to port: neither `pnpm typecheck` nor the test suite (scripts/test-files.mjs) reads them, and the 0.14
  // files they import are gone (the v0.14.7 tag has them, and 0.14's tests). Each goes from this list when its area
  // is moved or rewritten; one named here that no longer exists fails the suite.
  "exclude": [
    // Workloads' sign-in and renewal, their alerts, the AWS proof and vault-kv (W422).
    "src/alerts.ts",
    "src/auth-routes.ts",
    "src/api/workloads.ts",
    "src/db/workloads.ts",
    "src/plugins/vault-kv.ts",
    "src/workload-sessions.ts",
    "src/workloads/aws.ts",

    // The Node entry, in 0.16.1 (docs/design/0.16.md, "Node in 0.16.0").
    "src/node.ts",
    "src/node-sockets.ts"
  ]
}
