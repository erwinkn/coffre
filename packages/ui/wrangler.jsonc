// What `vite build` bundles as `@coffre/ui`: the pages, and nothing to bind.
// No deployment uses this file; each imports the build from its own Worker
// or Node server. `vite dev` uses dev/wrangler.jsonc instead.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coffre-ui",
  "main": "src/entry.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"]
}
