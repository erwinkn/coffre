{
  "name": "@coffre/ui",
  "version": "0.1.4",
  "description": "coffre's pages: a prebuilt TanStack Start handler and its static files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwinkn/coffre.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "coffre:source": {
        "types": "./src/types.ts",
        "workerd": "./src/entry.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && rm dist/server/wrangler.json && tsdown && node ../../scripts/check-client-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=coffre:source --test"
  },
  "dependencies": {
    "@coffre/client": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260920.1",
    "@coffre/core": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@vitejs/plugin-react": "6.0.3",
    "agentation": "3.0.2",
    "cmdk": "1.1.1",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "2.0.7",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wrangler": "4.118.0"
  }
}
