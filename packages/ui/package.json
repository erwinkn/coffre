{
  "name": "@coffre/ui",
  "version": "0.4.5",
  "description": "coffre's pages, for a deployment's own TanStack Start app: its router, and a Vite plugin for its build.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwinkn/coffre.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "coffre:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pages/*": {
      "coffre:source": "./src/pages/*.tsx",
      "types": "./dist/pages/*.d.ts",
      "default": "./dist/pages/*.js"
    },
    "./vite": {
      "coffre:source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./styles.css": "./src/styles/globals.css",
    "./icon.svg": "./src/assets/icon.svg",
    "./apple-touch-icon.png": "./src/assets/apple-touch-icon.png",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=coffre:source --test",
    "icons": "node scripts/icons.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@coffre/client": "workspace:*",
    "@coffre/core": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/router-core": "1.171.15",
    "lucide-react": "1.47.0",
    "sonner": "2.0.7"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.32",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.32",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@vitejs/plugin-react": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
