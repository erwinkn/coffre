{
  "name": "@coffre/client",
  "version": "0.1.15",
  "description": "The coffre API as typed function calls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwinkn/coffre.git",
    "directory": "packages/client"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "coffre:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routes": {
      "coffre:source": "./src/routes.ts",
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "generate": "node scripts/generate-api.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=coffre:source --test"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsdown": "0.23.0",
    "typescript": "5.9.3"
  }
}
