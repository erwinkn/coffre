{
  "name": "@coffre/client",
  "version": "0.1.0",
  "description": "The coffre API as typed function calls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwinkn/coffre.git",
    "directory": "packages/client"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "generate": "node scripts/generate-api.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "tsdown": "0.23.0",
    "typescript": "5.9.3"
  }
}
