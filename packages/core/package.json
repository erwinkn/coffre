{
  "name": "@coffre/core",
  "version": "0.1.0",
  "description": "What coffre's packages share: roles, envelopes, identity, the audit chain and the vault's contract.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwinkn/coffre.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./access": {
      "coffre:source": "./src/access.ts",
      "types": "./dist/access.d.ts",
      "default": "./dist/access.js"
    },
    "./audit": {
      "coffre:source": "./src/audit/chain.ts",
      "types": "./dist/audit.d.ts",
      "default": "./dist/audit.js"
    },
    "./dotenv": {
      "coffre:source": "./src/dotenv.ts",
      "types": "./dist/dotenv.d.ts",
      "default": "./dist/dotenv.js"
    },
    "./envelope": {
      "coffre:source": "./src/envelope.ts",
      "types": "./dist/envelope.d.ts",
      "default": "./dist/envelope.js"
    },
    "./identity": {
      "coffre:source": "./src/identity/index.ts",
      "types": "./dist/identity.d.ts",
      "default": "./dist/identity.js"
    },
    "./kek": {
      "coffre:source": "./src/kek/index.ts",
      "types": "./dist/kek.d.ts",
      "default": "./dist/kek.js"
    },
    "./schemas": {
      "coffre:source": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./vault": {
      "coffre:source": "./src/vault.ts",
      "types": "./dist/vault.d.ts",
      "default": "./dist/vault.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=coffre:source --test"
  },
  "dependencies": {
    "jose": "6.2.3",
    "oauth4webapi": "3.8.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsdown": "0.23.0",
    "typescript": "5.9.3"
  }
}
