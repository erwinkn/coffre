{
  "name": "@coffre/vault",
  "version": "0.1.0",
  "description": "coffre's vault: keys, grants and members, as a Cloudflare Worker or on Node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwinkn/coffre.git",
    "directory": "packages/vault"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "coffre:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "coffre:source": "./src/cloudflare.ts",
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./node": {
      "coffre:source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cloudflare.json",
    "test": "node --conditions=coffre:source --test"
  },
  "dependencies": {
    "@coffre/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260920.1",
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20260730.0-alpha",
    "tsdown": "0.23.0",
    "typescript": "5.9.3"
  }
}
