{
  "name": "@coffre/vault",
  "version": "0.1.1",
  "description": "coffre's vault: keys, grants and members, in the database the app uses, as a Cloudflare Worker or on Node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwinkn/coffre.git",
    "directory": "packages/vault"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "coffre:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "coffre:source": "./src/cloudflare.ts",
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./node": {
      "coffre:source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=coffre:source --test"
  },
  "dependencies": {
    "@coffre/core": "workspace:*",
    "@coffre/db": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "pg": "8.16.3",
    "tsdown": "0.23.0",
    "typescript": "5.9.3"
  }
}
