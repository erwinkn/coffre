{
  "name": "@coffre/vault",
  "version": "0.1.0",
  "description": "coffre's vault: keys, grants and members, as a Cloudflare Worker or on Node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwinkn/coffre.git",
    "directory": "packages/vault"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "generate": "drizzle-kit generate && node src/generate.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cloudflare.json",
    "test": "node --test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "libsql": "0.5.29"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260920.1",
    "@types/node": "26.1.1",
    "drizzle-kit": "0.31.10",
    "tsdown": "0.23.0",
    "typescript": "5.9.3"
  }
}
