# The vault's settings, read by `pnpm vault`. Copy to vault.env, readable by
# the vault's user alone.

VAULT_SOCKET=vault.sock
# From `coffre setup`: the server's database, as the vault's own login.
DATABASE_URL=postgres://coffre_vault_runtime:CHANGE_ME@127.0.0.1:5432/coffre

# From `coffre setup`, saved in your password manager first: the vault key,
# which decrypts every value, and its ID, which is not secret. A rotation
# gives the new key a new ID. The vault derives the key it signs its
# records with from it.
VAULT_KEY_ID=vault-1
VAULT_KEY=

# Comma-separated emails: the first people in, whom nobody can remove.
ROOT_ADMINS=you@example.com
