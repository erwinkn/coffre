{
  "name": "@coffre/cli",
  "version": "0.1.4",
  "description": "The coffre command line: secrets in your shell, and `coffre init` for a new deployment.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwinkn/coffre.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "coffre": "./dist/main.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-templates.ts && node scripts/copy-migrations.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=coffre:source --test"
  },
  "devDependencies": {
    "@coffre/client": "workspace:*",
    "@coffre/core": "workspace:*",
    "@coffre/db": "workspace:*",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "jsonc-parser": "3.3.1",
    "pg": "8.16.3",
    "tsdown": "0.23.0",
    "typescript": "5.9.3"
  }
}
