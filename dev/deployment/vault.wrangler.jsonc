// The vault Worker of `vite dev` (vault.ts), an auxiliary Worker of the
// app's: examples/workers/vault/wrangler.jsonc, with its keys from .env.dev.
// dev/start.sh points its Hyperdrive at local Postgres, as the vault's login,
// with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_VAULT_HYPERDRIVE.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "coffre-dev-vault",
  "main": "vault.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [{ "binding": "VAULT_HYPERDRIVE", "id": "local" }],
  "secrets": {
    "required": ["COFFRE_VAULT_KEY_ID", "COFFRE_VAULT_KEY", "COFFRE_ROOT_ADMINS"]
  }
}
