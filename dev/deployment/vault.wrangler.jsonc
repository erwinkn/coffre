// The vault Worker of `vite dev` (vault.ts), an auxiliary Worker of the
// app's: examples/workers/vault/wrangler.jsonc, with its keys from .env.dev.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "coffre-dev-vault",
  "main": "vault.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "VAULT_OBJECT", "class_name": "VaultObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VaultObject"] }],
  "secrets": {
    "required": ["COFFRE_KEK_ID", "COFFRE_KEK_LOCAL", "COFFRE_ROOT_ADMINS", "COFFRE_VAULT_SIGNING_KEY"]
  }
}
