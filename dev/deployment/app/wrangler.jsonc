// The app Worker of `vite dev` (src/server.ts): examples/workers/app/wrangler.jsonc,
// on loopback. dev/start.sh points Hyperdrive at local Postgres with
// CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE, and its
// environment overrides these vars: Wrangler hands the Worker the names
// declared here, from the shell when it has them, and nothing else.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "coffre-dev",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-06",
  // enable_request_signal: a request's signal fires when its caller hangs up, which
  // ends the credential proxy's upstream request with it (coffre sets no bound of its own).
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "vars": {
    // localhost, not 127.0.0.1: browsers make passkeys for a name, never for an IP address (docs/design/passkeys.md, section 7.1).
    "COFFRE_PUBLIC_URL": "http://localhost:3000",
    "COFFRE_DEV_PASSKEYS": "optional",
    "COFFRE_DEV_IDP_URL": "http://127.0.0.1:8081",
    "COFFRE_DEV_IDP_PUBLIC_URL": "http://127.0.0.1:8081"
  },
  "secrets": {
    "required": ["COFFRE_APP_KEY", "COFFRE_DEV_GITHUB_APP_KEY"]
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "local" }],
  "services": [{ "binding": "VAULT", "service": "coffre-dev-vault" }],
  // The credential proxy's tunnel: one object per `coffre run` and database, which holds its connections.
  // And each workload's gate, one object per service.
  "durable_objects": {
    "bindings": [
      { "name": "SOCKETS", "class_name": "CoffreSockets" },
      { "name": "GATES", "class_name": "CoffreGates" },
      // The audit log's anchor, one object for the instance: what the
      // heartbeat last verified, kept where whoever writes the database cannot.
      { "name": "ANCHOR", "class_name": "CoffreAnchor" }
    ]
  },
  "migrations": [
    { "tag": "sockets", "new_sqlite_classes": ["CoffreSockets"] },
    { "tag": "gates", "new_sqlite_classes": ["CoffreGates"] },
    { "tag": "anchor", "new_sqlite_classes": ["CoffreAnchor"] }
  ],
  // Sign-ins that take anyone, workloads' and MCP's OAuth requests: per
  // caller's address, each entry point apart (docs/design/oidc.md), as the examples.
  "ratelimits": [
    { "name": "SIGN_IN_PER_SOURCE", "namespace_id": "1006", "simple": { "limit": 10000, "period": 10 } }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
