// The dev deployment runs on Workers against the packages' sources (the
// `coffre:source` condition in app/vite.config.ts), but typechecks against
// their declarations, as a real deployment does: build @coffre/server and
// @coffre/vault first.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["@cloudflare/workers-types", "vite/client"],
    "customConditions": [],
    "jsx": "react-jsx"
  },
  "include": ["app/src", "vault/src"]
}
