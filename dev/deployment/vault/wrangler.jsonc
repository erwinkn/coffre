// The vault Worker of `vite dev` (src/worker.ts), an auxiliary Worker of the
// app's: examples/workers/vault/wrangler.jsonc, with its keys from .env.dev.
// dev/start.sh points its Hyperdrive configs at local Postgres, as the vault's
// login and the hot path's, with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_VAULT_HYPERDRIVE
// and CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HOT_HYPERDRIVE.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "coffre-dev-vault",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    { "binding": "VAULT_HYPERDRIVE", "id": "local" },
    { "binding": "HOT_HYPERDRIVE", "id": "local-hot" }
  ],
  "secrets": {
    "required": ["COFFRE_VAULT_KEY_ID", "COFFRE_VAULT_KEY", "COFFRE_OWNERS"]
  }
}
