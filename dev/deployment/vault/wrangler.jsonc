// The vault Worker of `vite dev` (src/worker.ts), an auxiliary Worker of the
// app's: examples/workers/vault/wrangler.jsonc, with its keys from .env.dev.
// dev/start.sh points its Hyperdrive at local Postgres, as the vault's login,
// with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_VAULT_HYPERDRIVE.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "coffre-dev-vault",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [{ "binding": "VAULT_HYPERDRIVE", "id": "local" }],
  // The signer, which src/worker.ts exports, as examples/workers binds it.
  "durable_objects": { "bindings": [{ "name": "SIGNER", "class_name": "CoffreSigner" }] },
  "migrations": [{ "tag": "signer", "new_sqlite_classes": ["CoffreSigner"] }],
  "secrets": {
    "required": ["COFFRE_VAULT_KEY_ID", "COFFRE_VAULT_KEY", "COFFRE_OWNERS"]
  }
}
