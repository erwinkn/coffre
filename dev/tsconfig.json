// The dev loop's Node side: the dev IdP's launcher, and the Vite config that
// runs the deployment. deployment/ has its own, for Workers.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The personas' test imports the seed's config, which is plain JavaScript.
    "allowJs": true
  },
  "include": ["vite.config.ts", "idp/**/*.ts", "test/**/*.ts"]
}
