# The npm supply chain is the largest untrusted input to a service that holds
# every credential we own. These settings are load-bearing, not style.
ignore-scripts=true
save-exact=true
strict-peer-dependencies=true
auto-install-peers=false
# Do not install a version published in the last 7 days. Most malicious package
# releases are yanked within hours; this window costs us nothing.
minimum-release-age=10080
