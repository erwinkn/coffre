{
  "name": "coffre-node",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vault": "node --env-file=vault.env src/vault.ts",
    "build": "vite build app",
    "start": "srvx --prod --host=127.0.0.1 app/dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "conformance": "coffre-conformance node"
  },
  "dependencies": {
    "@coffre/server": "0.4.2",
    "@coffre/ui": "0.4.2",
    "@coffre/vault": "0.4.2",
    "@libsql/client": "0.18.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.32",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "srvx": "0.11.22"
  },
  "devDependencies": {
    "@coffre/cli": "0.4.2",
    "@coffre/conformance": "0.4.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
