# The server's settings, read by `pnpm start`. Copy to .env.

PORT=3000
# Where people reach coffre, through the proxy that terminates TLS in front
# of it: an origin, no path.
PUBLIC_URL=https://secrets.example.com
# From `coffre setup`: the database, as the server's own login. The vault
# uses it through another.
DATABASE_URL=postgres://coffre_runtime:CHANGE_ME@127.0.0.1:5432/coffre
# The vault's socket, as in vault.env.
VAULT_SOCKET=vault.sock
# Where the server keeps the audit log's anchor: on a volume that outlives
# the process, and that only it writes.
AUDIT_ANCHOR=state/anchor.json

# A GitHub App whose callback is <PUBLIC_URL>/auth/callback/github, with
# read-only access to email addresses, or an OAuth app with that callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# A passkey after GitHub: optional (whoever holds one, and every Owner),
# required (everyone) or off (no one; docs/deployment-auth.md).
PASSKEYS=optional

# Optional: the same GitHub App's ID and private key's PEM, one line with
# \n for its newlines. Installed on your organizations, it then lists their
# repositories, private ones too, where a CI run is trusted
# (docs/github-app.md).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# Optional: the sign-ins one address may make to each entry point that
# takes anyone (a CI run's, an MCP client's OAuth requests), a 10-second
# window; 10,000 (1,000 a second) when unset. A fleet behind one NAT is one
# address.
# SIGN_IN_PER_SOURCE=10000

# From `coffre setup`, saved in your password manager first: the app key,
# which signs the server's log entries, sessions and tokens.
APP_KEY=
