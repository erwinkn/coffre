# The server's settings, read by `pnpm start`. Copy to .env.

PORT=3000
# Where people reach coffre, through the proxy that terminates TLS in front
# of it: an origin, no path.
PUBLIC_URL=https://secrets.example.com
# From `coffre setup`: the database, as the server's own login. The vault
# uses it through another.
DATABASE_URL=postgres://coffre_runtime:CHANGE_ME@127.0.0.1:5432/coffre
# The vault's socket, as in vault.env.
VAULT_SOCKET=vault.sock

# A GitHub OAuth app whose callback is <PUBLIC_URL>/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# From `coffre setup`, saved in your password manager first: the app key,
# which signs the server's log entries, sessions and tokens.
APP_KEY=
