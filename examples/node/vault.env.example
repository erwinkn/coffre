# The vault's settings, read by `pnpm vault`. Copy to vault.env, readable by
# the vault's user alone.

VAULT_SOCKET=vault.sock
# The vault's own SQLite file. Back it up; nothing else may open it.
VAULT_STORE=vault.db

# The key-encryption key: 32 random bytes, base64 (`openssl rand -base64 32`),
# and a name for it. A rotation gives the new one a new name.
KEK_ID=kek-1
KEK=
# 32 random bytes, base64: signs the audit checkpoints.
SIGNING_KEY=

# Comma-separated emails: the first people in, whom nobody can remove.
ROOT_ADMINS=you@example.com
