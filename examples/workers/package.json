{
  "name": "coffre-workers",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev -c app/wrangler.jsonc -c vault/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run -c vault/wrangler.jsonc && wrangler deploy --dry-run -c app/wrangler.jsonc",
    "migrate": "coffre-server migrate",
    "deploy": "wrangler deploy -c vault/wrangler.jsonc && wrangler deploy -c app/wrangler.jsonc",
    "conformance": "coffre-conformance workers"
  },
  "dependencies": {
    "@coffre/server": "0.1.10",
    "@coffre/ui": "0.1.10",
    "@coffre/vault": "0.1.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260920.1",
    "@coffre/conformance": "0.1.10",
    "typescript": "5.9.3",
    "wrangler": "4.118.0"
  }
}
