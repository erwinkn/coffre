// The vault Worker. No route and no workers.dev address: only the app
// Worker's service binding reaches it. Its secrets go in with
// `wrangler secret put <NAME> -c vault/wrangler.jsonc`, and locally in
// vault/.dev.vars.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "coffre-vault",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    // Names the KEK below: from `coffre setup`. A rotation gives the new one a new id.
    "KEK_ID": "kek-1",
    // Comma-separated emails: the first people in, whom nobody can remove.
    "ROOT_ADMINS": "you@example.com"
  },
  "secrets": {
    // From `coffre setup`: wrangler secret put KEK. The vault derives the key
    // it signs its records with from it.
    "required": ["KEK"]
  },
  // The app's database, as the vault's own login: `wrangler hyperdrive
  // create coffre-vault --caching-disabled --connection-string=<vault login
  // URL>` prints the id. Its own config, not the app's: the vault writes
  // members and grants, which the app's login may only read. Locally,
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_VAULT_HYPERDRIVE stands in.
  "hyperdrive": [{ "binding": "VAULT_HYPERDRIVE", "id": "replace-with-your-vault-hyperdrive-id" }]
}
