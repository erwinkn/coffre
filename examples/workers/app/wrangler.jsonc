// The app Worker. Settings that are not secret are `vars` below; the secrets
// go in with `wrangler secret put <NAME> -c app/wrangler.jsonc`, and locally
// in app/.dev.vars.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "coffre",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-06",
  // enable_request_signal: a request's signal fires when its caller hangs up, which
  // ends the credential proxy's upstream request with it (coffre sets no bound of its own).
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    // Where people reach coffre: an origin, no path. Add it as a route or
    // custom domain too.
    "PUBLIC_URL": "https://secrets.example.com",
    // A GitHub App whose callback is <PUBLIC_URL>/auth/callback/github, with
    // read-only access to email addresses, or an OAuth app with that callback.
    "GITHUB_CLIENT_ID": "replace-with-your-client-id",
    // A passkey after GitHub: "optional" (whoever holds one, and every
    // Owner), "required" (everyone) or "off" (no one; docs/deployment-auth.md).
    "PASSKEYS": "optional"
  },
  "secrets": {
    // APP_KEY is from `coffre setup`; the app never gets the vault's keys.
    "required": ["GITHUB_CLIENT_SECRET", "APP_KEY"]
  },
  // `wrangler hyperdrive create coffre --caching-disabled`, as `coffre setup`
  // shows it, prints the id. Caching must stay off, or a revoked session keeps working
  // for about a minute, and this file cannot set it: see README.md. Locally,
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE stands in for
  // the config.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "replace-with-your-hyperdrive-id" }],
  // The vault Worker, vault/wrangler.jsonc. Deploy it first.
  "services": [{ "binding": "VAULT", "service": "coffre-vault" }],
  // Where plugins' WebSockets run: the credential proxy's database tunnel, one
  // object per `coffre run` and database. Idle until you add the tunnel.
  // And each workload's gate, one object per service: what holds a key-bound
  // session's proofs to one use, and counts its limits.
  "durable_objects": {
    "bindings": [
      { "name": "SOCKETS", "class_name": "CoffreSockets" },
      { "name": "GATES", "class_name": "CoffreGates" },
      // The audit log's anchor, one object for the instance: what the
      // heartbeat last verified, kept where whoever writes the database cannot.
      { "name": "ANCHOR", "class_name": "CoffreAnchor" }
    ]
  },
  "migrations": [
    { "tag": "sockets", "new_sqlite_classes": ["CoffreSockets"] },
    { "tag": "gates", "new_sqlite_classes": ["CoffreGates"] },
    { "tag": "anchor", "new_sqlite_classes": ["CoffreAnchor"] }
  ],
  // The heartbeat and audit checkpoints.
  "triggers": { "crons": ["*/5 * * * *"] },
  // What a sign-in that takes anyone passes first, a CI run's or a
  // workload's, or an MCP client's OAuth request: the requests one address
  // makes to each, counted apart. 10,000 per 10 s is 1,000 a second, the
  // CI sign-in rate coffre is built for, which a fleet behind one NAT may
  // send from one address. Cloudflare counts per location, and takes a
  // period of 10 or 60 seconds.
  "ratelimits": [
    { "name": "SIGN_IN_PER_SOURCE", "namespace_id": "1006", "simple": { "limit": 10000, "period": 10 } }
  ]
}
