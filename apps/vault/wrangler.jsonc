// The vault: a Worker with no route and no HTTP surface, holding one Durable
// Object whose SQLite is the vault's store. The app reaches it only through
// the `VAULT` service binding in apps/web/wrangler.jsonc, whose calls land on
// `VaultEntrypoint`. Every key coffre has is a secret of this Worker, and of
// no other.
//
// In development and in the production smoke test it runs next to the app,
// as an auxiliary Worker of the app's Vite build (apps/web/vite.config.ts).
{
  "$schema": "../web/node_modules/wrangler/config-schema.json",
  "name": "coffre-vault",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [{ "name": "VAULT_OBJECT", "class_name": "VaultObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VaultObject"] }],
  "vars": {
    // At most this many data keys unwrapped per principal in any window.
    "COFFRE_BULK_LIMIT": "1000/15m"
  },
  // Add COFFRE_KEK_LOCAL_PREVIOUS here while rotating the KEK.
  "secrets": {
    "required": ["COFFRE_KEK_LOCAL", "COFFRE_KEK_ID", "COFFRE_ROOT_ADMINS", "COFFRE_VAULT_SIGNING_KEY"]
  }
}
