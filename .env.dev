# Local development only. Every value here is non-secret by construction.
# dev/start.sh reads this file and hands each value to whatever it names:
# coffre's packages read none of them themselves.
# The app's audit chain key (dev/deployment/app.ts). It lives outside the
# database.
COFFRE_APP_KEY=Y29mZnJlLWxvY2FsLWF1ZGl0LWNoYWluLWtleS0zMmI=

# The vault Worker's configuration (dev/deployment/vault.ts): the vault key,
# from which it derives the key it signs its records with, and the root admins. Each Worker is
# handed only the names its own config declares, so the app never sees these.
COFFRE_VAULT_KEY=Y29mZnJlLWxvY2FsLWRldi1rZWstMzItYnl0ZXMhISE=
COFFRE_VAULT_KEY_ID=vault-local-dev-1

# Read by the vault, and by the seed, which signs in as the first.
COFFRE_ROOT_ADMINS=admin@acme.example

# Where the CLI and the seed find the stack; dev/start.sh sets these to its
# own ports when they differ.
COFFRE_DEV_IDP_URL=http://127.0.0.1:8081
COFFRE_API_URL=http://127.0.0.1:3000
