# Local development only. Every value here is non-secret by construction.
# scripts/dev.sh reads this file and hands each value to whatever it names:
# coffre's packages read none of them themselves.
COFFRE_AUTH_MODE=dev

# The app's audit chain key (packages/ui/dev/app.ts). It lives outside the
# database.
COFFRE_AUDIT_CHAIN_KEY=Y29mZnJlLWxvY2FsLWF1ZGl0LWNoYWluLWtleS0zMmI=

# The vault Worker's configuration (packages/ui/dev/vault.ts): the KEK, the
# key it signs audit checkpoints with, and the root admins. Each Worker is
# handed only the names its own config declares, so the app never sees these.
COFFRE_KEK_LOCAL=Y29mZnJlLWxvY2FsLWRldi1rZWstMzItYnl0ZXMhISE=
COFFRE_KEK_ID=local-dev-1
COFFRE_VAULT_SIGNING_KEY=Y29mZnJlLWxvY2FsLXZhdWx0LXNpZ25pbmctc2VlZCE=

# Read by the vault, and by the seed, which signs in as the first.
COFFRE_ROOT_ADMINS=admin@acme.example

# The audience the dev IdP mints tokens for, which devIdp() expects too.
COFFRE_ACCESS_AUD=coffre-local-dev-aud

# Where the CLI and the seed find the stack; scripts/dev.sh sets these to its
# own ports when they differ.
COFFRE_DEV_IDP_URL=http://127.0.0.1:8081
COFFRE_API_URL=http://127.0.0.1:3000
