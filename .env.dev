# Local development only. Every value here is non-secret by construction.
COFFRE_DATABASE_URL=postgresql://coffre_owner:local-dev-only@127.0.0.1:55432/coffre
COFFRE_PORT=8080

# Local KEK and audit chain key. In production the KEK moves to Scaleway Key
# Manager (KekProvider gains a 'scaleway' implementation, same interface) and
# the chain key lives outside the database.
COFFRE_KEK_LOCAL=Y29mZnJlLWxvY2FsLWRldi1rZWstMzItYnl0ZXMhISE=
COFFRE_KEK_ID=local-dev-1
COFFRE_AUDIT_CHAIN_KEY=Y29mZnJlLWxvY2FsLWF1ZGl0LWNoYWluLWtleS0zMmI=

# Points at the dev IdP. In production these become the Cloudflare Access team
# domain, its cdn-cgi JWKS URL, and the Access application's AUD tag.
COFFRE_ACCESS_ISSUER=http://127.0.0.1:8081
COFFRE_ACCESS_JWKS_URL=http://127.0.0.1:8081/cdn-cgi/access/certs
COFFRE_ACCESS_AUD=coffre-local-dev-aud

COFFRE_ROOT_ADMINS=erwin@equisafe.io

COFFRE_DEV_IDP_URL=http://127.0.0.1:8081
COFFRE_API_URL=http://127.0.0.1:8080
