{
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "name": "coffre-web",
  "main": "../apps/web/src/server.ts",
  "services": [
    {
      "binding": "VAULT",
      "service": "coffre-vault",
      "entrypoint": "VaultWorker"
    }
  ],
  "vars": {
    "STAGE": "production",
    "PUBLIC_ORIGIN": "https://coffre.example.invalid"
  }
}
