{
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "name": "coffre-kms",
  "main": "../apps/kms/src/index.ts",
  "vars": {
    "INSTANCE_ID": "00000000-0000-4000-8000-000000000000",
    "KEY_PROVIDER": "local",
    "HTTP_ENABLED": "false"
  },
  "r2_buckets": [
    {
      "binding": "KEY_AUDIT",
      "bucket_name": "coffre-key-audit"
    }
  ]
}
