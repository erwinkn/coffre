{
  "name": "coffre",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./examples/*\" --filter ./dev run typecheck",
    "dev": "./dev/start.sh",
    "test": "pnpm lint && ./scripts/test-suite.sh",
    "test:sqlite": "pnpm lint && COFFRE_TEST_ENGINE=sqlite ./scripts/test-suite.sh",
    "test:all": "pnpm test && pnpm test:sqlite",
    "test:properties": "node --conditions=coffre:source scripts/test-properties.mjs",
    "test:schema": "./scripts/test-schema.sh",
    "conformance:workers": "./scripts/ensure-postgres.sh && node scripts/ensure-database.mjs coffre && pnpm --filter coffre-workers conformance --postgres postgresql://coffre_owner:local-dev-only@127.0.0.1:55432 --runtime postgresql://coffre_runtime:local-runtime-only@127.0.0.1:55432 --vault-runtime postgresql://coffre_vault_runtime:local-vault-only@127.0.0.1:55432",
    "conformance:node": "pnpm --filter coffre-node conformance",
    "test:consumer": "./scripts/consumer-test.sh",
    "lint": "eslint \"packages/*/{src,test,scripts}/**/*.{ts,tsx}\"",
    "check:pins": "node scripts/check-pins.mjs",
    "bump": "node scripts/bump.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --dir packages/db run db:migrate",
    "db:generate": "pnpm --dir packages/db run db:generate",
    "db:check": "pnpm --dir packages/db run db:check",
    "seed": "DATABASE_URL=postgresql://coffre_owner:local-dev-only@127.0.0.1:55432/coffre node --env-file=.env.dev dev/seed.mjs",
    "coffre": "node --conditions=coffre:source --env-file=.env.dev packages/cli/src/main.ts",
    "add:dep": "pnpm add --save-exact"
  },
  "dependencies": {
    "@coffre/db": "workspace:*",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.8.0"
  }
}
