{
  "name": "coffre",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:signin": "./scripts/dev.sh signin",
    "test": "pnpm lint && ./scripts/test-suite.sh",
    "test:sqlite": "pnpm lint && COFFRE_TEST_ENGINE=sqlite ./scripts/test-suite.sh",
    "test:mysql": "pnpm lint && COFFRE_TEST_ENGINE=mysql ./scripts/test-suite.sh",
    "test:all": "pnpm test && pnpm test:sqlite && pnpm test:mysql",
    "test:schema": "./scripts/test-schema.sh",
    "lint": "eslint \"packages/ui/src/**/*.{ts,tsx}\"",
    "check:pins": "node scripts/check-pins.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --dir packages/db run migrate",
    "db:generate": "pnpm --dir packages/db generate",
    "db:check": "pnpm --dir packages/db check",
    "seed": "DATABASE_URL=postgresql://coffre_owner:local-dev-only@127.0.0.1:55432/coffre node --env-file=.env.dev scripts/seed.mjs",
    "add:dep": "pnpm add --save-exact"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.8.0"
  }
}
